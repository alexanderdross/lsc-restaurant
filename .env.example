# Öffentliche Build-Variablen (werden zur Bauzeit ins Frontend eingebettet).
# Für lokale Entwicklung nach `.env.local` kopieren; in Cloudflare Workers Builds
# als (nicht geheime) Build-Variablen hinterlegen.

# Cloudflare Turnstile – öffentlicher Site-Key des Widgets:
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."

# Cloudflare Image Transformations aktivieren (echte Bildoptimierung via /cdn-cgi/image).
# Erst auf "true" setzen, wenn auf der Zone „Image Transformations" aktiviert ist
# (sonst wird das Originalbild ausgeliefert – funktioniert überall, auch auf *.workers.dev).
NEXT_PUBLIC_CF_IMAGE_RESIZING="false"
