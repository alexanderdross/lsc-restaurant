{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lsc-restaurant",
  // Cloudflare-Account „Dross:Media" – Deploy-Ziel explizit setzen.
  "account_id": "e8d2e50aa1f1d61d8c68ba490d7cdec1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // KEIN "limits"-Block hier eintragen, solange der Account auf dem Workers-Free-
  // Plan läuft: die API lehnt das Anlegen der Version sonst ab und JEDER Deploy
  // schlägt fehl mit
  //   "CPU limits are not supported for the Free plan. [code: 100328]"
  // Genau daran sind alle Deploys zwischen dem 03.08. und dem 20.08.2026
  // gescheitert. Erst nach einem Upgrade auf "Workers Paid" (Dashboard →
  // Workers & Pages → Plans) darf wieder z. B. "limits": { "cpu_ms": 30000 }
  // gesetzt werden – das ist dann auch das Gegenmittel gegen Error 1102
  // "Worker exceeded resource limits".
  "observability": {
    "enabled": true,
  },
  // SMTP-Zugangsdaten und der Turnstile-Secret-Key gehören NICHT hierhin,
  // sondern als Secrets an den Worker. Im Dashboard (kein Wrangler nötig):
  //   Workers & Pages → lsc-restaurant → Settings → Variables and Secrets
  //   → Add → Type "Secret" → Deploy
  // Benötigt werden: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM,
  // MAIL_TO und TURNSTILE_SECRET_KEY.
  // Von einem Rechner mit Wrangler alternativ: npx wrangler secret put <NAME>
  // Für lokale Entwicklung: in .dev.vars (siehe .dev.vars.example)
  //
  // Achtung: Build-Variablen (z. B. NEXT_PUBLIC_TURNSTILE_SITE_KEY) sind etwas
  // anderes und stehen unter Settings → Build → Build Variables and Secrets.
  // Sie wirken nur zur Bauzeit, nicht zur Laufzeit.
}
